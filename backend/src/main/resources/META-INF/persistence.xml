                value="com.mysql.cj.jdbc.Driver" />
            <property name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://devclimb-mysql-192e785-anhkhoatran1808-edeb.h.aivencloud.com:28238/defaultdb?useSSL=true&amp;requireSSL=true&amp;serverTimezone=UTC" />
            <property name="jakarta.persistence.jdbc.user"
                value="avnadmin" />
